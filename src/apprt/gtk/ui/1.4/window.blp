using Gtk 4.0;
using Adw 1;

template $GhosttyWindow: Adw.ApplicationWindow {
  styles [
    "window",
  ]

  close-request => $close_request();
  realize => $realize();
  notify::config => $notify_config();
  notify::fullscreened => $notify_fullscreened();
  notify::is-active => $notify_is_active();
  notify::maximized => $notify_maximized();
  notify::quick-terminal => $notify_quick_terminal();
  notify::scale-factor => $notify_scale_factor();
  default-width: 800;
  default-height: 600;
  // GTK4 grabs F10 input by default to focus the menubar icon. We want
  // to disable this so that terminal programs can capture F10 (such as htop)
  handle-menubar-accel: false;

  content: Adw.TabOverview tab_overview {
    create-tab => $overview_create_tab();
    notify::open => $overview_notify_open();
    view: tab_view;
    enable-new-tab: true;
    inverted: bind template.tabs-inverted;
    // Disable the title buttons (close, maximize, minimize, ...)
    // *inside* the tab overview if CSDs are disabled.
    // We do spare the search button, though.
    show-start-title-buttons: bind template.decorated;
    show-end-title-buttons: bind template.decorated;

    Gtk.Overlay {
      Gtk.Box {
        Gtk.Box {
          width-request: 48;
          visible: bind template.sidebar-visible;
        }

        Adw.ToolbarView toolbar {
          top-bar-style: bind template.toolbar-style;
          bottom-bar-style: bind template.toolbar-style;
          hexpand: true;
          vexpand: true;

          [top]
          Adw.HeaderBar {
            visible: bind template.headerbar-visible;

            title-widget: Adw.WindowTitle {
              title: bind $computed_title(template.config, template.title, template.title-override) as <string>;
              // Blueprint auto-formatter won't let me split this into multiple
              // lines. Let me explain myself. All parameters to a closure are used
              // as notifications to recompute the value of the closure. All
              // elements of a property chain are also subscribed to for changes.
              // This one long, ugly line saves us from manually building up this
              // massive notify chain in code.
              subtitle: bind $computed_subtitle(
                template.config,
                tab_view.selected-page.child as <$GhosttyTab>.active-surface as <$GhosttySurface>.pwd
                ) as <string>;
            };

            [start]
            Adw.SplitButton {
              visible: bind template.headerbar-new-tab-visible;
              clicked => $new_tab();
              icon-name: "tab-new-symbolic";
              tooltip-text: _("New Tab");
              dropdown-tooltip: _("New Split");
              menu-model: split_menu;
              can-focus: false;
              focus-on-click: false;
            }

            [end]
            Gtk.Box {
              Gtk.ToggleButton {
                icon-name: "view-grid-symbolic";
                tooltip-text: _("View Open Tabs");
                active: bind tab_overview.open bidirectional;
                can-focus: false;
                focus-on-click: false;
              }

              Gtk.MenuButton {
                notify::active => $notify_menu_active();
                icon-name: "open-menu-symbolic";
                menu-model: main_menu;
                tooltip-text: _("Main Menu");
                can-focus: false;
              }
            }
          }

          [top]
          Adw.TabBar tab_bar {
            autohide: bind template.tabs-autohide;
            expand-tabs: bind template.tabs-wide;
            inverted: bind template.tabs-inverted;
            view: tab_view;
            visible: bind template.tabs-visible;

            [start]
            Gtk.Box {
              orientation: horizontal;
              visible: bind $titlebar_style_is_tabs(template.titlebar-style) as <bool>;

              Gtk.WindowControls {
                side: start;
              }

              Adw.SplitButton {
                styles [
                  "flat",
                ]

                clicked => $new_tab();
                icon-name: "tab-new-symbolic";
                tooltip-text: _("New Tab");
                dropdown-tooltip: _("New Split");
                menu-model: split_menu;
                can-focus: false;
                focus-on-click: false;
              }
            }

            [end]
            Gtk.Box {
              orientation: horizontal;
              visible: bind $titlebar_style_is_tabs(template.titlebar-style) as <bool>;

              Gtk.ToggleButton {
                styles [
                  "flat",
                ]

                icon-name: "view-grid-symbolic";
                tooltip-text: _("View Open Tabs");
                active: bind tab_overview.open bidirectional;
                can-focus: false;
                focus-on-click: false;
              }

              Gtk.MenuButton {
                styles [
                  "flat",
                ]

                notify::active => $notify_menu_active();
                icon-name: "open-menu-symbolic";
                menu-model: main_menu;
                tooltip-text: _("Main Menu");
                can-focus: false;
              }

              Gtk.WindowControls {
                side: end;
              }
            }
          }

          Box {
            orientation: vertical;

            $GhosttyDebugWarning {
              visible: bind template.debug;
            }

            Adw.ToastOverlay toast_overlay {
              hexpand: true;
              vexpand: true;

              Adw.TabView tab_view {
                notify::n-pages => $notify_n_pages();
                notify::selected-page => $notify_selected_page();
                close-page => $close_page();
                page-attached => $page_attached();
                page-detached => $page_detached();
                create-window => $tab_create_window();
                setup-menu => $setup_tab_menu();
                menu-model: tab_context_menu;
                shortcuts: none;
              }
            }
          }
        }
      }

      [overlay]
      Gtk.Box tab_sidebar {
        orientation: vertical;
        halign: start;
        valign: fill;
        width-request: 48;
        visible: bind template.sidebar-visible;

        styles [
          "gizmo-sidebar",
          "sidebar",
        ]

        Gtk.Box {
          styles [
            "gizmo-sidebar-header",
          ]

          Gtk.Button {
            icon-name: "sidebar-show-symbolic";
            action-name: "win.toggle-sidebar";
            tooltip-text: _("Expand or Collapse Tabs");
            halign: start;

            styles [
              "flat",
              "gizmo-sidebar-toggle",
            ]
          }

          Gtk.Label {
            label: _("Tabs");
            visible: bind template.sidebar-expanded;
            hexpand: true;
            xalign: 0;

            styles [
              "heading",
            ]
          }

          Adw.SplitButton {
            visible: bind template.sidebar-expanded;
            clicked => $new_tab();
            label: _("New Tab");
            tooltip-text: _("New Tab");
            dropdown-tooltip: _("New Split");
            menu-model: split_menu;
            can-focus: false;
            focus-on-click: false;
            valign: center;

            styles [
              "flat",
              "gizmo-sidebar-new-tab",
            ]
          }
        }

        Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          vexpand: true;

          Gtk.ListBox tab_list {
            selection-mode: single;
            activate-on-single-click: false;
            tooltip-text: _("Tabs");

            styles [
              "navigation-sidebar",
              "gizmo-tab-list",
            ]
          }
        }

        Gtk.Box {
          orientation: vertical;
          visible: bind template.sidebar-controls-visible;

          Gtk.Button {
            visible: bind template.headerbar-new-tab-visible;
            icon-name: "tab-new-symbolic";
            action-name: "win.new-tab";
            tooltip-text: _("New Tab");

            styles [
              "flat",
            ]
          }

          Gtk.ToggleButton {
            icon-name: "view-grid-symbolic";
            active: bind tab_overview.open bidirectional;
            tooltip-text: _("View Open Tabs");

            styles [
              "flat",
            ]
          }

          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: main_menu;
            tooltip-text: _("Main Menu");
            notify::active => $notify_menu_active();

            styles [
              "flat",
            ]
          }
        }
      }
    }
  };
}

menu split_menu {
  item {
    label: _("Split Up");
    action: "win.split-up";
  }

  item {
    label: _("Split Down");
    action: "win.split-down";
  }

  item {
    label: _("Split Left");
    action: "win.split-left";
  }

  item {
    label: _("Split Right");
    action: "win.split-right";
  }
}

menu main_menu {
  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Paste");
      action: "win.paste";
    }
  }

  section {
    item {
      label: _("Change Window Title…");
      action: "win.prompt-window-title";
    }

    item {
      label: _("New Window");
      action: "win.new-window";
    }

    item {
      label: _("Close Window");
      action: "win.close";
    }
  }

  section {
    item {
      label: _("Change Tab Title…");
      action: "win.prompt-tab-title";
    }

    item {
      label: _("New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Close Tab");
      action: "win.close-tab";
      target: "this";
    }

    submenu {
      label: _("Gizmo Tab Orientation");

      item {
        label: _("Horizontal Tabs");
        action: "win.set-tabs-orientation";
        target: "horizontal";
      }

      item {
        label: _("Vertical Tabs");
        action: "win.set-tabs-orientation";
        target: "vertical";
      }

      item {
        label: _("Switch Tab Orientation");
        action: "win.toggle-tabs-orientation";
      }

      item {
        label: _("Compact Sidebar");
        action: "win.set-sidebar-state";
        target: "compact";
      }

      item {
        label: _("Expanded Sidebar");
        action: "win.set-sidebar-state";
        target: "expanded";
      }

      item {
        label: _("Hide Sidebar");
        action: "win.set-sidebar-state";
        target: "hidden";
      }

      item {
        label: _("Focus Tab List");
        action: "win.focus-tab-list";
      }
    }
  }

  section {
    submenu {
      label: _("Split");

      item {
        label: _("Change Title…");
        action: "win.prompt-surface-title";
      }

      item {
        label: _("Split Up");
        action: "win.split-up";
      }

      item {
        label: _("Split Down");
        action: "win.split-down";
      }

      item {
        label: _("Split Left");
        action: "win.split-left";
      }

      item {
        label: _("Split Right");
        action: "win.split-right";
      }
    }
  }

  section {
    item {
      label: _("Clear");
      action: "win.clear";
    }

    item {
      label: _("Reset");
      action: "win.reset";
    }
  }

  section {
    item {
      label: _("Command Palette");
      action: "win.toggle-command-palette";
    }

    item {
      label: _("Terminal Inspector");
      action: "win.toggle-inspector";
    }

    submenu {
      label: _("Config");

      item {
        label: _("Open Configuration in OS Editor");
        action: "app.open-config";
        target: "os-open";
      }

      item {
        label: _("Open Configuration in New Window");
        action: "app.open-config";
        target: "new-window";
      }

      item {
        label: _("Reload Configuration");
        action: "app.reload-config";
      }
    }
  }

  section {
    item {
      label: _("About Ghostty");
      action: "win.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}

menu tab_context_menu {
  item {
    label: _("Change Tab Title…");
    action: "win.prompt-context-tab-title";
  }

  item {
    label: _("Move Tab Up");
    action: "win.context-tab-operation";
    target: "up";
  }

  item {
    label: _("Move Tab Down");
    action: "win.context-tab-operation";
    target: "down";
  }

  item {
    label: _("Move Tab to New Window");
    action: "win.context-tab-operation";
    target: "detach";
  }

  item {
    label: _("Close Tab");
    action: "win.context-tab-operation";
    target: "close";
  }

  item {
    label: _("Close Other Tabs");
    action: "win.context-tab-operation";
    target: "close-other";
  }
}
